# Chave da API do Google Gemini (obrigatória para Visão Multimodal e Search Grounding)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Valor médio do milheiro (1.000 pontos Livelo/Esfera) em Reais (BRL)
DEFAULT_MILE_VALUE_BRL=30.00

# Configurações de Scraping / Playwright
HEADLESS_BROWSER=true
SCRAPE_TIMEOUT_SECONDS=25

# URL do Backend para o Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
